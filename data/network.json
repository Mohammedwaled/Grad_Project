              "description": "Path traversal in Apache HTTP Server 2.4.49"
            }
          ]
        }
      ]
    },
    {
      "id": "db-01",
      "type": "database",
      "criticality": "critical",
      "ports": [3306],
      "services": [
        {
          "name": "mysql",
          "port": 3306,
          "protocol": "TCP"
        }
      ]
    }
  ],
  "connections": [
    {
      "source": "web-01",
      "target": "db-01",
      "port": 3306,
      "protocol": "TCP"
    }
  ]
