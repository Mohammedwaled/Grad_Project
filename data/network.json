{
  "$schema": "./schema/network.schema.json",
  "network_name": "CyberDT-Lab",
  "devices": [
    {
      "id": "web-01",
      "type": "web_server",
      "criticality": "high",
      "ports": [443],
      "services": [
        {
          "name": "https",
          "port": 443,
          "protocol": "TCP",
          "version": "Apache 2.4.49",
          "vulnerabilities": [
            {
              "id": "CVE-2021-41773",
