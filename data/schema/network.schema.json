{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cyber Digital Twin - Network Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["network_name", "devices", "connections"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "network_name": {
      "type": "string",
      "minLength": 1
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/device" }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    }
  },
  "$defs": {
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "protocol": {
      "type": "string",
      "enum": ["TCP", "UDP"]
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "criticality", "ports", "services"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "web_server",
            "application_server",
            "database",
            "firewall",
            "router",
            "switch",
            "workstation",
            "server"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "ports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/port" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/service" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "port", "protocol"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "port": { "$ref": "#/$defs/port" },
        "protocol": { "$ref": "#/$defs/protocol" },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "vulnerabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/vulnerability" }
        }
      }
    },
    "vulnerability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cvss"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cvss": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "description": {
          "type": "string"
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "port", "protocol"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "port": { "$ref": "#/$defs/port" },
        "protocol": { "$ref": "#/$defs/protocol" }
      }
    }
  }
}
